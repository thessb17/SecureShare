# =============================================================================
# SecureShare - example environment file
# Copy to .env and replace every value. NEVER commit a real .env.
# Generate secrets with:  python -c "import secrets;print(secrets.token_urlsafe(50))"
# =============================================================================

# --- Core -------------------------------------------------------------------
# NOTE: exporting this variable also overrides the ini default used by pytest.
# The suite protects itself with --ds=config.settings.test in pytest.ini, so
# tests always run against the test settings even with this file sourced.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=replace-me-with-a-50-char-random-value
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
LOG_LEVEL=INFO
LOG_TO_FILE=True

# --- Docker Compose only -----------------------------------------------------
# Consumed by docker-compose.yml, not by Django. POSTGRES_PASSWORD has no
# default and `docker compose up` refuses to start without it; it must match
# the password inside DATABASE_URL above. The others fall back to these values.
POSTGRES_PASSWORD=change-me-to-match-DATABASE_URL
POSTGRES_USER=secureshare
POSTGRES_DB=secureshare
HTTP_PORT=8080
HTTPS_PORT=8443

# --- Database (PostgreSQL) ---------------------------------------------------
# Replace change-me with the password you gave the secureshare role.
DATABASE_URL=postgresql://secureshare:change-me@127.0.0.1:5432/secureshare
DB_SSLMODE=prefer
DB_CONN_MAX_AGE=60

# --- Redis / Celery ----------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# --- JWT ---------------------------------------------------------------------
JWT_SIGNING_KEY=replace-me-with-another-50-char-random-value
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1
JWT_ISSUER=secureshare

# --- Password policy / lockout ----------------------------------------------
MIN_PASSWORD_LENGTH=12
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
PASSWORD_RESET_TIMEOUT_SECONDS=3600

# --- CORS / CSRF (explicit origins only; never "*") --------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=False

# --- Envelope encryption keys ------------------------------------------------
# No key material ships with this repository. Create your own pair first:
#     python scripts/generate_keys.py
# Losing rsa_private.pem makes every stored file permanently unrecoverable.
RSA_PRIVATE_KEY_PATH=./keys/rsa_private.pem
RSA_PUBLIC_KEY_PATH=./keys/rsa_public.pem
# RSA_PRIVATE_KEY_PEM=                # inline PEM injected by a secret manager
# RSA_PRIVATE_KEY_PASSPHRASE=
# RSA_RETIRED_PRIVATE_KEY_PATHS=./keys/rsa_private.2025.pem

# --- Encrypted object storage ------------------------------------------------
ENCRYPTED_STORAGE_BACKEND=security.storage.LocalEncryptedStorage
ENCRYPTED_STORAGE_ROOT=./storage/encrypted
FILE_UPLOAD_TEMP_DIR=./storage/tmp
MEDIA_ROOT=./storage/media
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_REGION=

# --- Upload policy -----------------------------------------------------------
MAX_UPLOAD_SIZE=26214400
ALLOWED_UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg,txt,csv,docx,xlsx,pptx,zip
ENCRYPTION_CHUNK_SIZE=1048576
DOWNLOAD_BUFFER_THRESHOLD=8388608

# --- Malware scanning (ClamAV) ----------------------------------------------
CLAMAV_ENABLED=False
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_FAIL_CLOSED=True

# --- Sharing / public share links -------------------------------------------
PUBLIC_SHARE_BASE_URL=http://localhost:5173
SHARE_LINK_TOKEN_BYTES=32
SHARE_LINK_DEFAULT_TTL_SECONDS=86400
SHARE_LINK_MAX_TTL_SECONDS=2592000
SHARE_LINK_MAX_DOWNLOADS_CAP=10000
SHARE_LINK_PASSWORD_MAX_ATTEMPTS=5
SHARE_LINK_PASSWORD_LOCKOUT_SECONDS=900
SHARE_LINK_GRANT_TTL_SECONDS=600
SHARE_LINK_MIN_PASSWORD_LENGTH=8
SHARE_LINK_RETENTION_DAYS=30
FILE_SHARE_MAX_TTL_SECONDS=7776000

# --- Rate limits (DRF throttle rates) ---------------------------------------
THROTTLE_ANON=120/hour
THROTTLE_USER=2000/hour
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=5/hour
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_UPLOAD=60/hour
THROTTLE_DOWNLOAD=300/hour
THROTTLE_SHARE_CREATE=60/hour
THROTTLE_SHARE_ACCESS=60/hour
THROTTLE_SHARE_DOWNLOAD=60/hour
THROTTLE_SHARE_PASSWORD=10/hour

# --- Email (password reset / verification) ----------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@secureshare.local
FRONTEND_BASE_URL=http://localhost:5173

# --- Reverse proxy / HTTPS ---------------------------------------------------
TRUSTED_PROXY_COUNT=0
TRUST_PROXY_SSL_HEADER=False
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# --- Django admin (off by default) ------------------------------------------
DJANGO_ADMIN_ENABLED=False
DJANGO_ADMIN_URL=django-admin/
